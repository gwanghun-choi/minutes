# PostgreSQL. It runs as its own container on the shared external Docker
# network `minutes-net`, so the host is its container name - not an IP, and not
# localhost, which inside this container is this container.
DATABASE_HOST=minutes-postgres
DATABASE_PORT=5432
DATABASE_NAME=minutes
DATABASE_SCHEMA=minutes
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Hugging Face token for pyannote/speaker-diarization-community-1
# (the account must have accepted the model licence)
HF_TOKEN=

# OpenAI, used only to generate the final chat answer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# faster-whisper
# WHISPER_DEVICE: auto | cuda | cpu
# WHISPER_COMPUTE_TYPE: auto | int8 | float16 | int8_float16
# WHISPER_LANGUAGE: empty = autodetect, or a code such as ko
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=

# Embedding model. Its dimension is the source of truth for the DB vector column.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto

UPLOAD_DIR=data/uploads
